# Run python3 app/docker/init_env.py to generate .env.docker safely.
# Never commit the generated file. Password must be URL-safe (generator uses hex).
COFFEE_DB_PASSWORD=
LIGHTRAG_API_KEY=
COFFEE_PORT=8088
AI_MODE=demo
# Existing default remains direct Gemini. For OpenRouter set AI_PROVIDER=openrouter,
# LIGHTRAG_URL=http://lightrag-openrouter:9621 and start --profile openrouter.
AI_PROVIDER=gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
LIGHTRAG_URL=http://lightrag:9621
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# For another local port update both COFFEE_PORT and ALLOWED_HOSTS.
ALLOWED_HOSTS=localhost:8088,127.0.0.1:8088
# Set HTTPS origin + COOKIE_SECURE=true behind your reverse proxy for deployment.
PUBLIC_ORIGIN=
COOKIE_SECURE=false

# Separate local staff token; never sent to Gemini. Generate at least 24 random characters.
COFFEE_STAFF_TOKEN=

# Concurrency, not a requests/minute limiter. Retry failed ingestion after quota recovery.
LIGHTRAG_MAX_ASYNC_LLM=1

# Show source/tool-step details in the chat UI only when explicitly true.
COFFEE_DEBUG_UI=false

# Public trial is controlled separately from the local app.
PREVIEW_DEBUG_UI=false
